#ifndef PRODUCT_IDENTITY_H
#define PRODUCT_IDENTITY_H

#include <stdint.h>

#define HC32_PRODUCT_HARDWARE_ID   UINT32_C(@HC32_HARDWARE_ID_VALUE@)
#define HC32_PRODUCT_BOARD_ID      UINT32_C(@HC32_BOARD_ID_VALUE@)
#define HC32_PRODUCT_BOARD_REVISION UINT16_C(@HC32_BOARD_REVISION_VALUE@)
#define HC32_PRODUCT_USB_VID       UINT16_C(@HC32_USB_VID_VALUE@)
#define HC32_PRODUCT_USB_BOOT_PID  UINT16_C(@HC32_USB_BOOT_PID_VALUE@)
#define HC32_PRODUCT_USB_APPLICATION_PID UINT16_C(@HC32_USB_APPLICATION_PID_VALUE@)
#define HC32_PRODUCT_USB_MANUFACTURER "@HC32_USB_MANUFACTURER@"
#define HC32_PRODUCT_USB_BOOT_PRODUCT "@HC32_USB_BOOT_PRODUCT@"
#define HC32_PRODUCT_USB_APPLICATION_PRODUCT "@HC32_USB_APPLICATION_PRODUCT@"
#define HC32_PRODUCT_USB_SERIAL_PREFIX "@HC32_USB_SERIAL_PREFIX@"

#define HC32_COMPATIBILITY_TLV_TYPE UINT16_C(0x00A0)
#define HC32_COMPATIBILITY_FORMAT_VERSION UINT8_C(1)
#define HC32_COMPATIBILITY_PAYLOAD_SIZE 12U

#endif
