# Project-owner supplied USB identity; the firmware appends the HC32 96-bit UQID.
HC32_PRODUCT_CLASS=production
HC32_HARDWARE_ID=0x00004600
HC32_BOARD_ID=1
HC32_BOARD_REVISION=2
HC32_USB_VID=0xCAFE
HC32_USB_BOOT_PID=0x0001
HC32_USB_APPLICATION_PID=0x0002
HC32_USB_APPLICATION_PID_MIN=0x0002
HC32_USB_APPLICATION_PID_MAX=0x00FF
HC32_USB_MANUFACTURER=SingularXYZ
HC32_USB_BOOT_PRODUCT=Slam-ChargerManager Boot-Recovery
HC32_USB_APPLICATION_PRODUCT=Slam-ChargerManager USB
HC32_USB_SERIAL_PREFIX=HC32F460-
