import {
    Button,
    ComboBox,
    LineEdit,
    Palette,
    ProgressIndicator,
    ScrollView,
    Spinner,
    Switch,
} from "std-widgets.slint";

// icon selects an Icons.by-id() glyph; tone 0 = neutral, 1 = good, 2 = warning.
export struct DebugValueRow {
    name: string,
    value: string,
    icon: int,
    tone: int,
}

// One BQ40Z50 pack; tone 0 = idle, 1 = charging/full, 2 = alarm. Values are preformatted with units.
export struct BatteryCard {
    title: string,
    present: bool,
    state: string,
    tone: int,
    soc: int,
    capacity: string,
    voltage: string,
    current: string,
    power: string,
    temperature: string,
    charge-target: string,
    cycles: string,
    alarms: string,
}

export struct DebugSettingRow {
    key: int,
    name: string,
    current: string,
    edit-value: string,
    detail: string,
}

// Colors follow the platform light/dark scheme so the std widgets and custom surfaces stay consistent.
global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> window: dark ? #131519 : #f3f4f6;
    out property <color> surface: dark ? #1d2026 : #ffffff;
    out property <color> surface-alt: dark ? #23272e : #f7f8fa;
    out property <color> border: dark ? #2d323b : #e4e7ec;
    out property <color> text: dark ? #e7e9ed : #1b1f27;
    out property <color> muted: dark ? #9099a6 : #667085;
    out property <color> accent: dark ? #5b93ff : #2563eb;
    out property <color> accent-soft: dark ? #1f2c46 : #e9f0ff;
    out property <color> hover: dark ? #262a32 : #eef0f3;
    out property <color> success: dark ? #3ccf86 : #16a34a;
    out property <color> success-soft: dark ? #173326 : #e7f6ec;
    out property <color> warning: dark ? #f0b84b : #b45309;
    out property <color> warning-soft: dark ? #3a2e17 : #fff4e0;
    out property <color> danger: dark ? #ff6b6b : #dc2626;
    out property <color> danger-soft: dark ? #3b1d1f : #fdecec;
}

// Stroke icons drawn on a 24x24 grid as SVG path data, so no icon font or colour-emoji support is needed.
export global Icons {
    out property <string> chip: "M7 4 H17 A3 3 0 0 1 20 7 V17 A3 3 0 0 1 17 20 H7 A3 3 0 0 1 4 17 V7 A3 3 0 0 1 7 4 Z M9.5 9.5 H14.5 V14.5 H9.5 Z M9 1.5 V4 M15 1.5 V4 M9 20 V22.5 M15 20 V22.5 M1.5 9 H4 M1.5 15 H4 M20 9 H22.5 M20 15 H22.5";
    out property <string> tag: "M3 12 L12 3 H21 V12 L12 21 Z M16 6.5 A1.5 1.5 0 1 0 16 9.5 A1.5 1.5 0 1 0 16 6.5 Z";
    out property <string> hash: "M10 3 L8 21 M16 3 L14 21 M4 8.5 H20 M3.5 15.5 H19.5";
    out property <string> plug: "M9 2 V7 M15 2 V7 M6 7 H18 V11 A6 6 0 0 1 6 11 Z M12 17 V22";
    out property <string> clock: "M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 7 V12 L15.5 14";
    out property <string> loop: "M20 12 A8 8 0 1 1 17.66 6.34 M20 3.5 V8.5 H15";
    out property <string> battery: "M2.5 7 H18.5 V17 H2.5 Z M21.5 10 V14 M6 10.5 V13.5 M9.5 10.5 V13.5 M13 10.5 V13.5";
    out property <string> bolt: "M13 2 L4 14 H11 L10 22 L20 9.5 H13 Z";
    out property <string> alert: "M12 3 L22 20.5 H2 Z M12 9.5 V14 M12 17 V17.5";
    out property <string> download: "M12 3 V15 M7 10 L12 15 L17 10 M4 20 H20";
    out property <string> shield: "M12 2 L20 5 V11 C20 16 16.5 20 12 22 C7.5 20 4 16 4 11 V5 Z M9 12 L11 14 L15 10";
    out property <string> key: "M7.5 8 A4 4 0 1 0 7.5 16 A4 4 0 1 0 7.5 8 Z M11.5 12 H21.5 M18 12 V15.5 M21.5 12 V15";
    out property <string> sliders: "M4 6 H20 M4 12 H20 M4 18 H20 M9 3.5 V8.5 M15 9.5 V14.5 M7 15.5 V20.5";
    out property <string> chart: "M5 20 V11 M11 20 V4 M17 20 V14 M2.5 20.5 H21.5";
    out property <string> trash: "M4 7 H20 M9.5 7 V4 H14.5 V7 M6 7 L7 21 H17 L18 7 M10 11 V17 M14 11 V17";
    out property <string> power: "M12 3 V12 M7.5 6.5 A7.5 7.5 0 1 0 16.5 6.5";
    out property <string> play: "M8 5 L19 12 L8 19 Z";
    out property <string> link: "M10 14 L14 10 M8.5 11.5 L6 14 A3.2 3.2 0 0 0 10 18 L12.5 15.5 M15.5 12.5 L18 10 A3.2 3.2 0 0 0 14 6 L11.5 8.5";
    out property <string> pulse: "M2 12 H6 L9 5 L14 19 L17 12 H22";
    out property <string> lock: "M6 11 H18 V21 H6 Z M8.5 11 V7.5 A3.5 3.5 0 0 1 15.5 7.5 V11";
    out property <string> unlock: "M6 11 H18 V21 H6 Z M8.5 11 V7.5 A3.5 3.5 0 0 1 15.2 6";
    out property <string> file: "M6 2.5 H14 L19 7.5 V21.5 H6 Z M14 2.5 V7.5 H19";

    public pure function by-id(id: int) -> string {
        if id == 1 { return self.clock; }
        if id == 2 { return self.loop; }
        if id == 3 { return self.chip; }
        if id == 4 { return self.battery; }
        if id == 5 { return self.bolt; }
        if id == 6 { return self.alert; }
        if id == 7 { return self.download; }
        if id == 8 { return self.power; }
        if id == 9 { return self.chart; }
        if id == 10 { return self.plug; }
        return self.pulse;
    }
}

component Icon inherits Path {
    viewbox-width: 24;
    viewbox-height: 24;
    width: 18px;
    height: 18px;
    fill: transparent;
    stroke: Theme.accent;
    stroke-width: 1.8px;
}

// Rounded tinted square holding one icon, used in headers and list rows.
component IconBadge inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.accent;
    in property <color> fill: Theme.accent-soft;
    in property <length> size: 30px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 3.2;
    background: root.fill;

    Icon {
        commands: root.icon;
        stroke: root.tint;
        width: root.size * 0.56;
        height: root.size * 0.56;
    }
}

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        @children
    }
}

component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon;
    in property <color> tint: Theme.accent;
    in property <color> fill: Theme.accent-soft;
    spacing: 12px;

    if root.icon != "": VerticalLayout {
        alignment: start;
        IconBadge {
            icon: root.icon;
            tint: root.tint;
            fill: root.fill;
            size: 34px;
        }
    }

    VerticalLayout {
        spacing: 3px;
        alignment: center;
        horizontal-stretch: 1;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 600;
        }

        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.muted;
    in property <color> fill: Theme.hover;
    border-radius: 11px;
    background: root.fill;
    animate background { duration: 200ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.tint;
                animate background { duration: 200ms; easing: ease-out; }
            }
        }

        Text {
            text: root.text;
            color: root.tint;
            animate color { duration: 200ms; easing: ease-out; }
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component KeyValueRow inherits Rectangle {
    in property <string> name;
    in property <string> value;
    in property <bool> shaded;
    in property <string> icon;
    in property <int> tone;
    border-radius: 6px;
    background: root.shaded ? Theme.surface-alt : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 12px;

        if root.icon != "": VerticalLayout {
            alignment: center;
            IconBadge {
                icon: root.icon;
                size: 26px;
                tint: root.tone == 1 ? Theme.success : root.tone == 2 ? Theme.warning : Theme.accent;
                fill: root.tone == 1 ? Theme.success-soft : root.tone == 2 ? Theme.warning-soft : Theme.accent-soft;
            }
        }

        Text {
            text: root.name;
            color: Theme.muted;
            min-width: 150px;
            horizontal-stretch: 0;
            vertical-alignment: center;
        }

        Text {
            text: root.value;
            color: root.tone == 1 ? Theme.success : root.tone == 2 ? Theme.warning : Theme.text;
            font-family: "monospace";
            horizontal-stretch: 1;
            horizontal-alignment: right;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

component InfoItem inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> icon;
    spacing: 10px;

    VerticalLayout {
        alignment: center;
        IconBadge {
            icon: root.icon;
            size: 28px;
        }
    }

    VerticalLayout {
        spacing: 1px;
        alignment: center;
        Text {
            text: root.label;
            color: Theme.muted;
            font-size: 11px;
            font-weight: 600;
        }

        Text {
            text: root.value;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    border-radius: 8px;
    background: root.active ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        padding-right: 10px;
        spacing: 10px;

        Rectangle {
            width: 3px;
            border-radius: 1.5px;
            background: root.active ? Theme.accent : transparent;
            animate background { duration: 150ms; easing: ease-out; }
        }

        VerticalLayout {
            alignment: center;
            Icon {
                commands: root.icon;
                stroke: root.active ? Theme.accent : Theme.muted;
            }
        }

        VerticalLayout {
            spacing: 1px;
            Text {
                text: root.text;
                color: root.active ? Theme.accent : Theme.text;
                font-size: 14px;
                font-weight: root.active ? 600 : 500;
            }

            Text {
                text: root.hint;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component FormField inherits VerticalLayout {
    in property <string> label;
    spacing: 6px;

    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 600;
    }

    @children
}

// Fades its content in when it is created, so switching pages does not snap.
component FadePage inherits Rectangle {
    property <float> shown: 0;
    opacity: self.shown;
    animate shown { duration: 220ms; easing: ease-out; }
    init => {
        self.shown = 1;
    }

    VerticalLayout {
        spacing: 16px;
        @children
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

component EmptyHint inherits Text {
    color: Theme.muted;
    font-size: 12px;
    horizontal-alignment: center;
}

component BatteryMetric inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 2px;
    horizontal-stretch: 1;

    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 11px;
    }

    Text {
        text: root.value;
        color: Theme.text;
        font-family: "monospace";
        font-size: 14px;
    }
}

component BatteryPanel inherits Rectangle {
    in property <BatteryCard> pack;
    property <color> tint: root.pack.tone == 1 ? Theme.success : root.pack.tone == 2 ? Theme.warning : Theme.accent;
    property <color> fill: root.pack.tone == 1 ? Theme.success-soft : root.pack.tone == 2 ? Theme.warning-soft : Theme.accent-soft;
    horizontal-stretch: 1;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface-alt;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 10px;
            IconBadge {
                icon: Icons.battery;
                tint: root.tint;
                fill: root.fill;
            }

            Text {
                text: root.pack.title;
                color: Theme.text;
                font-weight: 600;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                Badge {
                    text: root.pack.state;
                    tint: root.pack.present ? root.tint : Theme.muted;
                    fill: root.pack.present ? root.fill : Theme.hover;
                }
            }
        }

        if !root.pack.present: EmptyHint {
            text: "Pack not detected or not answering on I2C.";
        }

        if root.pack.present: VerticalLayout {
            spacing: 10px;

            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.pack.soc + "%";
                    color: root.tint;
                    font-size: 28px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text {
                        text: root.pack.capacity;
                        color: Theme.muted;
                        font-family: "monospace";
                    }

                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.hover;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.pack.soc, 0, 100) / 100;
                            height: parent.height;
                            border-radius: 4px;
                            background: root.tint;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                BatteryMetric {
                    label: "Voltage";
                    value: root.pack.voltage;
                }

                BatteryMetric {
                    label: "Current";
                    value: root.pack.current;
                }

                BatteryMetric {
                    label: "Power";
                    value: root.pack.power;
                }
            }

            HorizontalLayout {
                spacing: 12px;
                BatteryMetric {
                    label: "Temperature";
                    value: root.pack.temperature;
                }

                BatteryMetric {
                    label: "Charge target";
                    value: root.pack.charge-target;
                }

                BatteryMetric {
                    label: "Cycles";
                    value: root.pack.cycles;
                }
            }

            if root.pack.alarms != "": Text {
                text: "Alarm: " + root.pack.alarms;
                color: Theme.warning;
                wrap: word-wrap;
            }
        }
    }
}

component Dialog inherits Rectangle {
    in property <string> heading;
    in property <string> body;
    in property <length> dialog-width: 460px;
    in property <bool> danger;
    property <float> shown: 0;
    background: #000000a0;
    opacity: self.shown;
    animate shown { duration: 160ms; easing: ease-out; }
    init => {
        self.shown = 1;
    }

    TouchArea { }

    Rectangle {
        width: min(parent.width - 48px, root.dialog-width);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: 14px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000060;

        content := VerticalLayout {
            padding: 24px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 4px;
                    border-radius: 2px;
                    background: root.danger ? Theme.danger : Theme.warning;
                }

                Text {
                    text: root.heading;
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
            }

            Text {
                text: root.body;
                color: Theme.muted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                @children
            }
        }
    }
}

export component UpdaterWindow inherits Window {
    in property <string> app-version;
    title: "HC32 Firmware Updater " + root.app-version;
    icon: @image-url("../assets/hc32-updater.png");
    preferred-width: 1040px;
    preferred-height: 780px;
    min-width: 860px;
    min-height: 600px;
    background: Theme.window;

    in-out property <string> firmware-path;
    in property <[string]> device-model;
    in-out property <int> selected-device: -1;
    in property <bool> device-connected: false;
    in property <bool> can-connect: false;
    in property <bool> can-disconnect: false;
    in property <bool> can-configure: false;
    in property <bool> device-provisioned: false;
    in property <string> device-serial: "—";
    in property <string> device-hardware-version: "—";
    in property <string> device-application-pid: "—";
    in property <string> device-version: "—";
    in property <string> device-boot-version: "—";
    in property <string> device-mode: "—";
    in property <bool> device-in-boot: false;
    in property <bool> device-admin-capable: false;
    in property <string> firmware-version: "Not selected";
    in property <string> firmware-sha256: "Not checked";
    in property <string> status-text: "Ready";
    in property <float> progress: 0;
    in property <string> progress-label: "0%";
    // Restart and reconnect run indeterminate: their duration depends on the Boot swap and USB enumeration.
    in property <bool> progress-indeterminate: false;
    // 0 = in progress, 1 = finished, 2 = failed.
    in property <int> progress-tone: 0;
    in property <bool> reconnecting: false;
    property <int> reconnect-seconds: 0;
    property <float> shown-progress: root.progress;
    animate shown-progress { duration: 300ms; easing: ease-out; }
    in property <bool> busy: false;
    in-out property <string> config-device-serial;
    in-out property <string> config-hardware-version;
    in-out property <string> config-application-pid;
    in property <string> product-config-status: "Not read";
    in-out property <bool> warning-visible: false;
    in-out property <string> warning-text;
    in property <bool> debug-available: false;
    in property <bool> debug-connected: false;
    in property <bool> debug-busy: false;
    in property <bool> debug-streaming: false;
    in property <string> debug-status: "Open Debug on a connected Application device";
    in property <[DebugValueRow]> debug-telemetry;
    in property <[BatteryCard]> debug-batteries;
    in property <[DebugValueRow]> debug-charger;
    in property <[DebugSettingRow]> debug-settings;
    in-out property <string> debug-period: "1000";
    in-out property <bool> debug-confirm-visible: false;
    in property <string> debug-confirm-text;
    in property <bool> admin-unlocked: false;
    in property <bool> admin-verified: false;
    in property <string> admin-fingerprint: "No key loaded";
    in-out property <bool> admin-erase-confirm-visible: false;

    callback refresh-device();
    callback connect-device(int);
    callback disconnect-device();
    callback configure-device(string, string, string);
    callback browse-firmware();
    callback install-firmware(string);
    callback debug-open();
    callback debug-refresh();
    callback debug-start(string);
    callback debug-stop();
    callback debug-close();
    callback debug-edit-setting(int, string);
    callback debug-apply-setting(int);
    callback debug-reset();
    callback debug-confirm();
    callback admin-load-key();
    callback admin-lock();
    // Drops the key without a status message; fired when Boot Recovery ends (Exit Boot, reset or disconnect).
    callback admin-release();
    callback admin-verify();
    callback admin-erase();
    callback reboot-device(bool);

    // Every action is disabled while a USB operation or a confirmation is pending.
    property <bool> idle: !root.busy && !root.debug-busy && !root.debug-confirm-visible
        && !root.admin-erase-confirm-visible;
    in-out property <int> page: 0;
    changed reconnecting => {
        self.reconnect-seconds = 0;
    }
    Timer {
        interval: 1s;
        running: root.reconnecting;
        triggered => {
            root.reconnect-seconds += 1;
        }
    }

    changed device-in-boot => {
        if !self.device-in-boot && self.admin-unlocked {
            root.admin-release();
        }
    }

    VerticalLayout {
        // Header
        Rectangle {
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 36px;
                        height: 36px;
                        source: @image-url("../assets/hc32-updater.png");
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "Firmware Updater";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                    }

                    Text {
                        text: "HC32F460 · MCUboot · USB · Boot + App · " + root.app-version;
                        color: Theme.muted;
                        font-size: 12px;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if root.admin-unlocked: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Badge {
                        text: "Administrator";
                        tint: Theme.danger;
                        fill: Theme.danger-soft;
                    }
                }

                if root.device-connected || root.reconnecting: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Badge {
                        text: root.reconnecting ? "Restarting… " + root.reconnect-seconds + " s" : root.device-mode;
                        tint: root.reconnecting || root.device-in-boot ? Theme.warning : Theme.accent;
                        fill: root.reconnecting || root.device-in-boot ? Theme.warning-soft : Theme.accent-soft;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Badge {
                        text: root.device-connected ? "Connected" : "Disconnected";
                        tint: root.device-connected ? Theme.success : Theme.muted;
                        fill: root.device-connected ? Theme.success-soft : Theme.hover;
                    }
                }
            }
        }

        Divider { }

        // Device selection toolbar
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            spacing: 8px;

            ComboBox {
                horizontal-stretch: 1;
                model: root.device-model;
                current-index <=> root.selected-device;
                enabled: root.idle && !root.device-connected && root.device-model.length > 0;
            }

            Button {
                text: "Refresh";
                enabled: root.idle && !root.device-connected;
                clicked => {
                    root.refresh-device();
                }
            }

            Button {
                text: "Connect";
                primary: true;
                enabled: root.idle && root.can-connect && root.selected-device >= 0;
                clicked => {
                    root.connect-device(root.selected-device);
                }
            }

            Button {
                text: root.device-in-boot ? "Exit Boot" : "Enter Boot";
                enabled: root.idle && root.device-connected;
                clicked => {
                    root.reboot-device(!root.device-in-boot);
                }
            }

            Button {
                text: "Disconnect";
                enabled: root.idle && root.can-disconnect;
                clicked => {
                    root.disconnect-device();
                }
            }
        }

        // Body: device summary and navigation on the left, page content on the right
        HorizontalLayout {
            vertical-stretch: 1;
            padding: 24px;
            padding-top: 16px;
            spacing: 20px;

            VerticalLayout {
                width: 230px;
                spacing: 16px;

                Card {
                    Text {
                        text: "DEVICE";
                        color: Theme.muted;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    InfoItem {
                        label: "Serial number";
                        value: root.device-serial;
                        icon: Icons.hash;
                    }

                    InfoItem {
                        label: "Application version";
                        value: root.device-version;
                        icon: Icons.tag;
                    }

                    InfoItem {
                        label: "Boot version";
                        value: root.device-boot-version;
                        icon: Icons.shield;
                    }

                    InfoItem {
                        label: "Hardware version";
                        value: root.device-hardware-version;
                        icon: Icons.chip;
                    }

                    InfoItem {
                        label: "App USB PID";
                        value: root.device-application-pid;
                        icon: Icons.plug;
                    }
                }

                VerticalLayout {
                    spacing: 4px;

                    NavItem {
                        text: "Firmware Update";
                        hint: "Install a signed image";
                        icon: Icons.download;
                        active: root.page == 0;
                        clicked => {
                            root.page = 0;
                        }
                    }

                    NavItem {
                        text: "Monitor";
                        hint: "Battery, charger, settings";
                        icon: Icons.pulse;
                        active: root.page == 1;
                        clicked => {
                            root.page = 1;
                        }
                    }

                    NavItem {
                        text: "Device Setup";
                        hint: "Write-once manufacturing";
                        icon: Icons.sliders;
                        active: root.page == 2;
                        clicked => {
                            root.page = 2;
                        }
                    }

                    NavItem {
                        text: "Administrator";
                        hint: root.admin-unlocked ? "Unlocked" : "Key required";
                        icon: root.admin-unlocked ? Icons.unlock : Icons.shield;
                        active: root.page == 3;
                        clicked => {
                            root.page = 3;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }
            }

            ScrollView {
                horizontal-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    spacing: 16px;
                    padding-right: 12px;

                    if root.page == 0: FadePage {

                        Card {
                            SectionHeader {
                                title: "Firmware image";
                                subtitle: "Select artifacts/app-signed-<version>.bin. Slot-padded primary/update images are rejected.";
                                icon: Icons.file;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.firmware-path;
                                    enabled: root.idle;
                                    placeholder-text: "Path to app-signed-<version>.bin";
                                }

                                Button {
                                    text: "Browse…";
                                    enabled: root.idle;
                                    clicked => {
                                        root.browse-firmware();
                                    }
                                }
                            }

                            VerticalLayout {
                                KeyValueRow {
                                    name: "Image version";
                                    value: root.firmware-version;
                                    shaded: true;
                                }

                                KeyValueRow {
                                    name: "SHA-256";
                                    value: root.firmware-sha256;
                                }
                            }
                        }

                        Card {
                            HorizontalLayout {
                                spacing: 12px;
                                SectionHeader {
                                    horizontal-stretch: 1;
                                    title: "Install";
                                    subtitle: root.device-in-boot
                                        ? "Boot Recovery receives the image into the Secondary slot, verifies the signature, swaps and starts the new Application."
                                        : "Installation runs in Boot Recovery. Click Enter Boot in the toolbar first.";
                                    icon: Icons.download;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Install update";
                                        primary: true;
                                        enabled: root.idle && root.device-connected && root.device-in-boot
                                            && root.firmware-path != "";
                                        clicked => {
                                            root.install-firmware(root.firmware-path);
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    ProgressIndicator {
                                        height: 8px;
                                        progress: root.shown-progress;
                                        indeterminate: root.progress-indeterminate;
                                    }
                                }

                                Text {
                                    width: 56px;
                                    text: root.progress-indeterminate ? root.reconnect-seconds + " s" : root.progress-label;
                                    color: root.progress-tone == 1 ? Theme.success : root.progress-tone == 2 ? Theme.danger : Theme.text;
                                    animate color { duration: 200ms; easing: ease-out; }
                                    font-family: "monospace";
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if root.page == 1: FadePage {

                        Card {
                            HorizontalLayout {
                                spacing: 8px;
                                SectionHeader {
                                    horizontal-stretch: 1;
                                    title: "Monitor session";
                                    subtitle: root.debug-status;
                                    icon: Icons.link;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Open";
                                        primary: !root.debug-connected;
                                        enabled: root.debug-available && root.idle && !root.debug-connected;
                                        clicked => {
                                            root.debug-open();
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Close";
                                        enabled: root.debug-connected && root.idle;
                                        clicked => {
                                            root.debug-close();
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Refresh";
                                        enabled: root.debug-connected && root.idle;
                                        clicked => {
                                            root.debug-refresh();
                                        }
                                    }
                                }
                            }

                            Divider { }

                            HorizontalLayout {
                                spacing: 10px;

                                Text {
                                    text: "Update every";
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    width: 90px;
                                    text <=> root.debug-period;
                                    enabled: root.idle && !root.debug-streaming;
                                    input-type: number;
                                }

                                Text {
                                    text: "ms (100–5000)";
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                Button {
                                    text: "Start";
                                    primary: true;
                                    enabled: root.debug-connected && !root.debug-streaming && root.idle;
                                    clicked => {
                                        root.debug-start(root.debug-period);
                                    }
                                }

                                Button {
                                    text: "Stop";
                                    enabled: root.debug-streaming && root.idle;
                                    clicked => {
                                        root.debug-stop();
                                    }
                                }
                            }
                        }

                        Card {
                            SectionHeader {
                                title: "Battery";
                                subtitle: "BQ40Z50 fuel gauge, refreshed by the device once per second. Positive current is charging.";
                                icon: Icons.battery;
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                for pack in root.debug-batteries: BatteryPanel {
                                    pack: pack;
                                }
                            }

                            if root.debug-batteries.length == 0: EmptyHint {
                                text: "No battery data yet. Open the monitor, then Refresh or Start.";
                            }
                        }

                        Card {
                            SectionHeader {
                                title: "Charger";
                                subtitle: "MP2762A charge controller and its PG / INT# pins. Register scaling is preliminary until validated on hardware.";
                                icon: Icons.bolt;
                            }

                            VerticalLayout {
                                for field[index] in root.debug-charger: KeyValueRow {
                                    name: field.name;
                                    value: field.value;
                                    icon: Icons.by-id(field.icon);
                                    tone: field.tone;
                                    shaded: Math.mod(index, 2) == 0;
                                }
                            }

                            if root.debug-charger.length == 0: EmptyHint {
                                text: "No charger data yet. Open the monitor, then Refresh or Start.";
                            }
                        }

                        Card {
                            HorizontalLayout {
                                SectionHeader {
                                    horizontal-stretch: 1;
                                    title: "System status";
                                    icon: Icons.pulse;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Badge {
                                        text: root.debug-streaming ? "Live" : "Paused";
                                        tint: root.debug-streaming ? Theme.success : Theme.muted;
                                        fill: root.debug-streaming ? Theme.success-soft : Theme.hover;
                                    }
                                }
                            }

                            VerticalLayout {
                                for field[index] in root.debug-telemetry: KeyValueRow {
                                    name: field.name;
                                    value: field.value;
                                    icon: Icons.by-id(field.icon);
                                    tone: field.tone;
                                    shaded: Math.mod(index, 2) == 0;
                                }
                            }

                            if root.debug-telemetry.length == 0: EmptyHint {
                                text: "No status yet. Open the monitor, then Refresh or Start.";
                            }
                        }

                        Card {
                            HorizontalLayout {
                                spacing: 8px;
                                SectionHeader {
                                    horizontal-stretch: 1;
                                    title: "Settings";
                                    subtitle: "Stored in the device app_kv partition. Each change needs confirmation.";
                                    icon: Icons.sliders;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Reset all…";
                                        enabled: root.debug-connected && root.idle;
                                        clicked => {
                                            root.debug-reset();
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                for setting[index] in root.debug-settings: Rectangle {
                                    border-radius: 8px;
                                    background: Math.mod(index, 2) == 0 ? Theme.surface-alt : transparent;

                                    HorizontalLayout {
                                        padding: 10px;
                                        spacing: 10px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: setting.name;
                                                color: Theme.text;
                                                font-weight: 600;
                                            }

                                            Text {
                                                text: setting.detail;
                                                color: Theme.muted;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                border-radius: 6px;
                                                background: Theme.accent-soft;
                                                min-width: 64px;
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    padding-top: 4px;
                                                    padding-bottom: 4px;
                                                    Text {
                                                        text: setting.current;
                                                        color: Theme.accent;
                                                        font-family: "monospace";
                                                        horizontal-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        LineEdit {
                                            width: 96px;
                                            text: setting.edit-value;
                                            enabled: root.debug-connected && root.idle;
                                            edited(value) => {
                                                root.debug-edit-setting(index, value);
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Button {
                                                text: "Apply…";
                                                enabled: root.debug-connected && root.idle;
                                                clicked => {
                                                    root.debug-apply-setting(index);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.debug-settings.length == 0: EmptyHint {
                                text: "Settings load after Open Debug.";
                            }
                        }
                    }

                    if root.page == 2: FadePage {

                        Card {
                            HorizontalLayout {
                                spacing: 8px;
                                SectionHeader {
                                    horizontal-stretch: 1;
                                    title: "Product configuration";
                                    subtitle: "Accepted only in Boot Recovery, and only once per device. An administrator factory erase allows it again.";
                                    icon: Icons.sliders;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Badge {
                                        text: root.product-config-status;
                                        tint: root.device-provisioned ? Theme.success : Theme.warning;
                                        fill: root.device-provisioned ? Theme.success-soft : Theme.warning-soft;
                                    }
                                }
                            }

                            GridLayout {
                                spacing: 12px;
                                Row {
                                    FormField {
                                        horizontal-stretch: 1;
                                        label: "Device serial";
                                        LineEdit {
                                            text <=> root.config-device-serial;
                                            enabled: root.idle && root.can-configure;
                                            placeholder-text: "Letters and digits, up to 32";
                                        }
                                    }

                                    FormField {
                                        horizontal-stretch: 1;
                                        label: "Hardware version";
                                        LineEdit {
                                            text <=> root.config-hardware-version;
                                            enabled: root.idle && root.can-configure;
                                            placeholder-text: "For example A1.2";
                                        }
                                    }
                                }

                                Row {
                                    FormField {
                                        horizontal-stretch: 1;
                                        label: "App USB PID";
                                        LineEdit {
                                            text <=> root.config-application-pid;
                                            enabled: root.idle && root.can-configure;
                                            placeholder-text: "Hexadecimal, for example 0x0002";
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            Divider { }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "These values cannot be changed after they are written.";
                                    color: Theme.warning;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }

                                Button {
                                    text: "Configure once";
                                    primary: true;
                                    enabled: root.idle && root.can-configure;
                                    clicked => {
                                        root.configure-device(root.config-device-serial, root.config-hardware-version,
                                        root.config-application-pid);
                                    }
                                }
                            }
                        }
                    }

                    if root.page == 3: FadePage {

                        Card {
                            HorizontalLayout {
                                spacing: 8px;
                                SectionHeader {
                                    horizontal-stretch: 1;
                                    title: "Administrator key";
                                    subtitle: "Load the administrator ECDSA-P256 private key (PEM). It stays on this computer; the device only checks a signature over its own random challenge.";
                                    icon: Icons.key;
                                    tint: Theme.danger;
                                    fill: Theme.danger-soft;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Badge {
                                        text: root.admin-verified ? "Verified" : root.admin-unlocked ? "Key loaded" : "Locked";
                                        tint: root.admin-verified ? Theme.success : root.admin-unlocked ? Theme.warning : Theme.muted;
                                        fill: root.admin-verified ? Theme.success-soft : root.admin-unlocked ? Theme.warning-soft : Theme.hover;
                                    }
                                }
                            }

                            KeyValueRow {
                                name: "Key fingerprint";
                                value: root.admin-fingerprint;
                                icon: root.admin-unlocked ? Icons.unlock : Icons.lock;
                                shaded: true;
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                Button {
                                    text: "Lock";
                                    enabled: root.idle && root.admin-unlocked && root.device-in-boot;
                                    clicked => {
                                        root.admin-lock();
                                    }
                                }

                                Button {
                                    text: "Load key…";
                                    primary: !root.admin-unlocked;
                                    enabled: root.idle && root.device-connected && root.device-in-boot;
                                    clicked => {
                                        root.admin-load-key();
                                    }
                                }

                                Button {
                                    text: "Verify on device";
                                    enabled: root.idle && root.admin-unlocked && root.device-connected && root.device-in-boot
                                        && root.device-admin-capable;
                                    clicked => {
                                        root.admin-verify();
                                    }
                                }
                            }
                        }

                        if !root.device-in-boot: Card {
                            SectionHeader {
                                title: "Boot Recovery required";
                                subtitle: root.device-connected
                                    ? "Administrator operations run in Boot Recovery. Click Enter Boot in the toolbar first."
                                    : "Connect a device, then click Enter Boot in the toolbar.";
                                icon: Icons.power;
                                tint: Theme.warning;
                                fill: Theme.warning-soft;
                            }
                        }

                        Card {
                            SectionHeader {
                                title: "Factory erase";
                                subtitle: "Erases the Primary and Secondary image slots, the scratch sector and Product Config. The device restarts unprovisioned in Boot Recovery with its factory USB serial, ready for Device Setup and a new install. Application settings are kept.";
                                icon: Icons.trash;
                                tint: Theme.danger;
                                fill: Theme.danger-soft;
                            }

                            if root.device-connected && root.device-in-boot && !root.device-admin-capable: Text {
                                text: "This Boot was built without an administrator key (HC32_ADMIN_PUBLIC_KEY).";
                                color: Theme.warning;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                alignment: end;
                                Button {
                                    text: "Erase device…";
                                    enabled: root.idle && root.admin-unlocked && root.device-connected && root.device-in-boot
                                        && root.device-admin-capable;
                                    clicked => {
                                        root.admin-erase-confirm-visible = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Status bar
        Divider { }

        Rectangle {
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 10px;

                if root.busy || root.debug-busy: Spinner {
                    width: 16px;
                    height: 16px;
                    indeterminate: true;
                }

                Text {
                    text: root.status-text;
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    if root.warning-visible: Dialog {
        width: 100%;
        height: 100%;
        heading: "Upgrade blocked";
        body: root.warning-text;

        Button {
            text: "OK";
            primary: true;
            clicked => {
                root.warning-visible = false;
            }
        }
    }

    if root.admin-erase-confirm-visible: Dialog {
        width: 100%;
        height: 100%;
        dialog-width: 520px;
        danger: true;
        heading: "Erase this device?";
        body: "Both application slots, the scratch sector and Product Config (" + root.device-serial
            + ") are erased permanently. The device will need Device Setup and a new firmware install. This cannot be undone.";

        Button {
            text: "Cancel";
            clicked => {
                root.admin-erase-confirm-visible = false;
            }
        }

        Button {
            text: "Erase";
            primary: true;
            enabled: root.device-connected && !root.busy && !root.debug-busy;
            clicked => {
                root.admin-erase-confirm-visible = false;
                root.admin-erase();
            }
        }
    }

    if root.debug-confirm-visible: Dialog {
        width: 100%;
        height: 100%;
        dialog-width: 500px;
        heading: "Confirm persistent settings change";
        body: root.debug-confirm-text;

        Button {
            text: "Cancel";
            clicked => {
                root.debug-confirm-visible = false;
            }
        }

        Button {
            text: "Confirm";
            primary: true;
            enabled: root.debug-connected && !root.busy && !root.debug-busy;
            clicked => {
                root.debug-confirm-visible = false;
                root.debug-confirm();
            }
        }
    }
}
