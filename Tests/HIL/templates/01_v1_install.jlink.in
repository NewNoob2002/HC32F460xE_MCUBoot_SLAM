device HC32F460xE
si SWD
speed @HIL_SWD_SPEED_KHZ@
connect
halt
savebin @HIL_BACKUP_BIN@, 0x00000000, 0x00076000
erase 0x00000000, 0x00075FFF
loadbin @HIL_BOOT_BIN@, 0x00000000
verifybin @HIL_BOOT_BIN@, 0x00000000
loadbin @HIL_V1_PRIMARY_BIN@, 0x00010000
verifybin @HIL_V1_PRIMARY_BIN@, 0x00010000
r
g
sleep @HIL_BOOT_WAIT_MS@
halt
mem32 0x00010000 8
mem32 0x00041FE0 8
mem32 0x1FFF8078 1
g
exit
